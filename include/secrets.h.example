// Copy this file to include/secrets.h and fill in your Wi-Fi details.
// include/secrets.h is ignored by git so credentials never get committed.
// Without this file the firmware still builds and starts its own access
// point (see FALLBACK_AP_SSID in src/config.h).
#pragma once

#define WIFI_SSID "your-network-name"
#define WIFI_PASSWORD "your-network-password"
